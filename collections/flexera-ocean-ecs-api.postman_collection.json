              "raw": "{\n  \"cluster\": {\n    \"name\": \"<string>\",\n    \"clusterName\": \"<string>\",\n    \"region\": \"<string>\",\n    \"autoScaler\": {\n      \"isEnabled\": \"<boolean>\",\n      \"isAutoConfig\": \"<boolean>\"\n    },\n    \"capacity\": {\n      \"target\": \"<integer>\",\n      \"minimum\": \"<integer>\",\n      \"maximum\": \"<integer>\"\n    },\n    \"compute\": {\n      \"instanceTypes\": {\n        \"whitelist\": [\n          \"<string>\",\n          \"<string>\"\n        ]\n      },\n      \"subnetIds\": [\n        \"<string>\",\n        \"<string>\"\n      ]\n    }\n  }\n}",
