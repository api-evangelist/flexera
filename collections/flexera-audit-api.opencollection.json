{
  "opencollection": "1.0.0",
  "info": {
    "name": "Spot Administration Access Policies Audit API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Audit",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Spot List Audit Events",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.spotinst.io/audit/events",
            "params": [
              {
                "name": "fromDate",
                "value": "2026-01-15T10:30:00Z",
                "type": "query",
                "description": "Start date for audit events."
              },
              {
                "name": "toDate",
                "value": "2026-01-15T10:30:00Z",
                "type": "query",
                "description": "End date for audit events."
              }
            ]
          },
          "docs": "Retrieve audit log events for the organization."
        }
      ]
    }
  ],
  "bundled": true
}