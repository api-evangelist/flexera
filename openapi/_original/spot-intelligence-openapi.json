                          "queue_num": 1,
                          "crossed_left": null,
                          "crossed_right": null
                        },
                        {
                          "object_id": "1687322709401|1",
                          "first_ms": 1687322709567,
                          "last_ms": 1687322737567,
                          "idle_sum": 27,
                          "queue_num": 2,
                          "crossed_left": null,
                          "crossed_right": null
                        },
                        {
                          "object_id": "1687322759950|1",
                          "first_ms": 1687322760116,
                          "last_ms": 1687322760116,
                          "idle_sum": 0,
                          "queue_num": 3,
                          "crossed_left": null,
                          "crossed_right": null
                        },
                        {
                          "object_id": "1687322759950|2",
                          "first_ms": 1687322771783,
                          "last_ms": 1687323599783,
                          "idle_sum": 828,
                          "queue_num": 4,
                          "crossed_left": null,
                          "crossed_right": null
                        }
                      ],
                      "total_count": 4
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation Failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "422": {
            "description": "Validation Failed. The error could be due to:\n      1) The maximum date range is 30 days. \n      2) Bucket size cannot be larger than date range",
