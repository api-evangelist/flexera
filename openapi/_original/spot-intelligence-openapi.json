        "description": "Count events and summary for a camera",
        "summary": "Count",
        "tags": [
          "Analytics"
        ],
        "security": [
          {
            "bearer_security": []
          }
        ],
        "parameters": [
          {
            "description": "Id of the camera",
            "in": "path",
            "name": "cameraId",
            "required": true,
            "schema": {
              "format": "double",
              "type": "number"
            }
          },
          {
            "description": "Type of entity to filter on (people, vehicles, or forklifts)",
            "in": "path",
            "name": "entity",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/IntelligenceEntities"
            }
          },
          {
            "description": "RFC3339 date string indicating the start of the date range filter (see https://datatracker.ietf.org/doc/html/rfc3339#section-5.6)",
            "in": "query",
            "name": "start_date",
            "required": true,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "RFC3339 date string indicating the end of the date range filter (see https://datatracker.ietf.org/doc/html/rfc3339#section-5.6)",
            "in": "query",
            "name": "end_date",
            "required": true,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "Time string indicating the beginning of the time range filter (HH:mm:ss)",
            "in": "query",
            "name": "start_time",
            "required": false,
            "schema": {
              "default": "00:00:00",
              "type": "string"
            }
          },
          {
            "description": "Time string indicating the end of the time range filter (HH:mm:ss)",
            "in": "query",
            "name": "end_time",
            "required": false,
            "schema": {
              "default": "23:59:59",
              "type": "string"
            }
          },
          {
            "description": "Minimum number of entities that must be present\nin a frame for it to be considered a presence event",
            "in": "query",
            "name": "threshold",
            "required": false,
            "schema": {
              "default": 1,
              "format": "double",
              "type": "number"
            }
          },
          {
            "description": "Array of numbers indicating which days of the week to include in the results",
            "in": "query",
            "name": "days_of_week",
            "required": false,
            "schema": {
              "default": [
                0,
                1,
                2,
                3,
                4,
                5,
                6
              ],
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              }
            }
          },
          {
            "description": "Size of the time buckets to group results by",
            "in": "query",
            "name": "bucket_size",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/BucketSize"
            }
          },
          {
            "in": "query",
            "name": "presence_threshold_seconds",
            "required": false,
            "schema": {
              "default": 0,
              "format": "double",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "presence_filter_seconds",
            "required": false,
            "schema": {
              "default": 0,
              "format": "double",
              "type": "number"
            }
          }
        ]
      }
    },
